{
  "name": "syno-pkg-connect-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint src test vite.config.ts vitest.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "build:upload": "node scripts/build-upload.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.48.0",
    "@synopackageland/sdk": "0.53.52",
    "@synopackageland/ui": "~0.25.31",
    "uqr": "0.1.3",
    "vue": "3.5.43"
  },
  "overrides": {
    "@synopackageland/sdk": {
      "@synopackageland/ui": "$@synopackageland/ui"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.0.3",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@10.33.2"
}
