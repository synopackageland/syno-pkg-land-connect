# Copy to .env (git-ignored) or export these, then: pnpm run e2e:nas
# No secrets here: passwords stay in the account files below (mode 600).
# Names follow the shared DSM e2e module (`@synopackageland/cli/e2e`).

# Account files: {"username","password"} or {"users":{"normal1":{...}}}.
DSM_E2E_ACCOUNT_ADMIN=/path/to/secrets/nas-admin.json
DSM_E2E_ACCOUNT_NORMAL1=/path/to/secrets/nas-normal-users.json

# Store text (descriptions, release notes) comes only from the catalog
# (schema 4) for check, build and inspect; or pass --catalog <catalog.yaml>.
SYNOPKGLAND_CATALOG=/path/to/catalog.yaml

# Optional: NAS reached only through the SSH tunnel `pnpm run e2e:nas` opens and closes.
# DSM_E2E_SSH=admin@nas.example
# Unset: the tunnel takes a free loopback port.
# DSM_E2E_TUNNEL_PORT=15498
# Profiles: ~/.cache/synopkgland-e2e/<target>-<user>.json
# DSM_E2E_TARGET=nas
# DSM_E2E_PROFILE_DIR=~/.cache/synopkgland-e2e

# Optional: e2e agent model (magpie); reasoning effort max by default.
# E2E_LLM_BASE_URL=http://127.0.0.1:3425/v1
# E2E_LLM_MODEL=codex/gpt-6-luna
# E2E_LLM_REASONING_EFFORT=max

# 1 lets suites change Connect's state (start/stop methods, check updates).
E2E_CONNECT_WRITE=0
